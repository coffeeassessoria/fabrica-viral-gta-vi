{
  "source": "Schemas and model metadata read from authenticated KAIROGEN MCP on 2026-11-13. No tokens, account data, or real prices.",
  "tools": [
    {
      "name": "list_models",
      "inputSchema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "image",
              "video"
            ]
          },
          "search": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_credits",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "estimate_cost",
      "inputSchema": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "aspect_ratio": {
            "type": "string",
            "minLength": 1
          },
          "resolution": {
            "type": "string",
            "minLength": 1
          },
          "quality": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": "string",
            "minLength": 1
          },
          "turbo": {
            "type": "boolean"
          },
          "generate_audio": {
            "type": "boolean"
          },
          "sound": {
            "type": "boolean"
          },
          "reference_image_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 2048,
              "format": "uri"
            },
            "maxItems": 30
          },
          "first_frame_url": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri"
          },
          "last_frame_url": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri"
          },
          "reference_video_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 2048,
              "format": "uri"
            },
            "maxItems": 30
          },
          "reference_audio_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 2048,
              "format": "uri"
            },
            "maxItems": 30
          },
          "extra_params": {
            "type": "object",
            "additionalProperties": {}
          },
          "preset_run_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "plan_key": {
            "type": "string",
            "enum": [
              "free",
              "start",
              "essential",
              "pro",
              "precision",
              "precisionPlus",
              "precisionMax",
              "creator"
            ]
          }
        },
        "required": [
          "model",
          "plan_key"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_generation",
      "inputSchema": {
        "type": "object",
        "properties": {
          "generation_id": {
            "type": "string",
            "minLength": 1
          },
          "wait_for_completion": {
            "type": "boolean"
          }
        },
        "required": [
          "generation_id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "generate_video",
      "inputSchema": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "aspect_ratio": {
            "type": "string"
          },
          "resolution": {
            "type": "string",
            "minLength": 1
          },
          "quality": {
            "type": "string",
            "minLength": 1
          },
          "turbo": {
            "type": "boolean"
          },
          "generate_audio": {
            "type": "boolean"
          },
          "first_frame_url": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri"
          },
          "last_frame_url": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri"
          },
          "reference_image_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 2048,
              "format": "uri"
            }
          },
          "character_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{24}$"
          },
          "preset_run_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "reference_video_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 2048,
              "format": "uri"
            }
          },
          "reference_audio_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 2048,
              "format": "uri"
            }
          },
          "quantity": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 2
          },
          "seed": {
            "type": "integer"
          },
          "extra_params": {
            "type": "object",
            "additionalProperties": {}
          },
          "expected_credits": {
            "type": "integer",
            "minimum": 0
          },
          "wait_for_completion": {
            "type": "boolean"
          },
          "timeout_seconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1800
          },
          "replay_of": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "model",
          "prompt"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ],
